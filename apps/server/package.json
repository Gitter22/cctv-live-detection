{
  "name": "@cctv/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "dotenv -e ../../.env -- vitest run",
    "prebuild": "npm run build --prefix ../../packages/shared",
    "pretypecheck": "npm run build --prefix ../../packages/shared",
    "pretest": "npm run build --prefix ../../packages/shared",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "postinstall": "prisma generate",
    "seed": "dotenv -e ../../.env -- tsx src/scripts/seed.ts",
    "import:home": "dotenv -e ../../.env -- tsx src/scripts/import-home.ts"
  },
  "dependencies": {
    "@cctv/shared": "^0.1.0",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
