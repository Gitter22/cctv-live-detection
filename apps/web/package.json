{
  "name": "@cctv/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../../packages/shared",
    "dev": "vite",
    "prebuild": "npm run build --prefix ../../packages/shared",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run build --prefix ../../packages/shared",
    "typecheck": "tsc -b --noEmit",
    "pretest": "npm run build --prefix ../../packages/shared",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@cctv/shared": "^0.1.0",
    "@tanstack/react-query": "^5.108.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  }
}
