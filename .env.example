# ---------------------------------------------------------------
# Vigil config. Copy to `.env` (gitignored) and fill in.
# Docker Compose reads `.env` automatically. All services get their
# settings from here.
# ---------------------------------------------------------------

COMPOSE_PROJECT_NAME=cctv

# --- Which parts run on this machine --------------------------
# server = hub (Postgres + API), edge = site box (go2rtc, MQTT, edge agent, vision)
COMPOSE_PROFILES=server,edge

# NVR / camera credentials are NOT configured here any more: add sources and cameras in the
# server (web app or API). They are stored encrypted and delivered only to the site's edge.

# --- go2rtc (restreamer + live view) ---------------------------
# Web UI / API: http://localhost:1984
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555

# --- MQTT broker (Mosquitto) -----------------------------------
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=cctv/v1

# --- Postgres (+ pgvector). Used by apps/server from step 2 ----
POSTGRES_USER=cctv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cctv
# Host port (5434 so it can sit next to trackr's 5433 and a local 5432)
POSTGRES_PORT=5434
# Host-side tools (Prisma CLI, tests) use this; the server container builds its own URL.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Server (apps/server) ---------------------------------------
SERVER_PORT=4000
# Browser origins allowed to call the API with cookies (comma separated)
WEB_ORIGINS=http://localhost:5173
# Signs login sessions. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-characters
# Encrypts NVR passwords / stream URLs in the DB (AES-256-GCM). 64 hex chars.
# Generate: openssl rand -hex 32   NEVER change it after storing secrets (they become unreadable).
SECRETS_KEY=
# First platform super admin (created by the seed script)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-please
SUPERADMIN_NAME="Platform Admin"

# --- Vision service --------------------------------------------
# Detector model (D-FINE, Apache-2.0) baked into the image at build time.
# Variants: n | s | m | l | x  (bigger = more accurate, slower)
DFINE_VARIANT=s
# CPU threads ONNX Runtime may use for inference
VISION_THREADS=4
LOG_LEVEL=INFO
# Optional: let the Docker build reuse your local uv download cache (saves re-downloading
# ~170 MB of wheels). Absolute path, e.g. /home/<you>/.cache/uv. Leave unset to download.
# UV_CACHE_HOST_DIR=

# --- TURN relay (optional, on the hub; profile "turn") -------
# Relays live video when viewer and site can't connect directly. Needs the hub's public IP.
# TURN_SECRET=          (openssl rand -hex 32)
# TURN_EXTERNAL_IP=     (public IP of the hub)
# TURN_URLS=turn:<public host>:3478?transport=udp,turn:<public host>:3478?transport=tcp

# --- Home import (npm run import:home -w apps/server) ---------
# One-time migration of the step-1 setup. Needs NVR_HOST/NVR_USER/NVR_PASSWORD (URL-encoded)
# only while it runs; remove them from .env afterwards.
# Owner of the "home" organization. Defaults to SUPERADMIN_EMAIL.
# HOME_OWNER_EMAIL=

# --- Edge (one per site; written by import:home or copied from the web app) ---
# EDGE_SITE_ID=
# EDGE_TOKEN=
# Hub URL as seen from the edge containers (default: the server container on this machine)
# EDGE_SERVER_URL=http://server:4000
# Where viewers' browsers reach this site's go2rtc player (LAN IP or Tailscale name)
# EDGE_LIVE_URL=http://192.168.1.50:1984
# Addresses viewers can reach go2rtc's WebRTC port at (comma separated). stun:8555 = public address via STUN.
# EDGE_WEBRTC_CANDIDATES=192.168.1.50:8555,stun:8555
