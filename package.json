{
  "name": "cctv-alerts",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "logs:vision": "docker compose logs -f vision",
    "events": "docker compose exec mosquitto mosquitto_sub -v -t 'cctv/v1/#'",
    "probe": "docker compose run --rm -v ./data/probe:/data/snapshots/probe vision python -m vision.probe",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w apps/server"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
